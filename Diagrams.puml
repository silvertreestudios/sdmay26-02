GridInterface <|-- GridRenderer3D
SingletonMonoBehaviour "<T=CameraManager>" <|-- CameraManager
SingletonMonoBehaviour "<T=GridInterface>" <|-- GridInterface
ITokenMovement <|.. TokenMovement
@enduml


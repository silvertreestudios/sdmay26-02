@startuml Standard
' UML Notation Guide:
' --> (Solid line, arrow): Association/Dependency - One class uses or has a reference to another
' <|-- (Solid line, triangle): Inheritance - One class inherits from another class
' <|.. (Dotted line, triangle): Interface Implementation - A class implements an interface
'
' sdmay26-02: Standard Class Diagram
' Open this file in VS Code with the PlantUML extension to preview/export.

skinparam classAttributeIconSize 0
skinparam dpi 150

class CameraManager {
  - entities : List<(string, GameObject)>
  - camera : Camera
  - currentCameraMode : CameraType
  + setCamera(Camera)
  + addActor(string, GameObject)
  + removeActor(string)
  + setCurrentActor(string)
  + setMode(CameraType)
  + update()
  + ResetClock()
}

class GridRenderer3D {
  + width : int
  + height : int
  + cellSize : float
  + origin : Vector3
  + gridY : float
  + targetCamera : Camera
  + HasHover : bool
  + HoverCell : Vector3Int
  + IsCellWalkable(int, int) : bool
  + SetStatus(int, int, TileStatus)
  + HasStatus(int, int, TileStatus) : bool
  + getIsOccupied(int, int) : bool
  + setIsOccupied(int, int, bool)
  + MoveCreature(GameObject) : IEnumerator
}

class GridCharacterController3D {
  + grid : GridRenderer3D
  + prefab : GameObject
  - tokenMovement : ITokenMovement
  - cameraManager : CameraManager
  + moveSpeed : float
  - SpawnCharacter()
  - Update()
  - TryGridWorldToCell(Vector3, out Vector3Int) : bool
  - Dijkstra(Vector3Int, Vector3Int) : (bool, float, List<Vector3Int>)
}

class TokenMovement {
  - objectTransform : Transform
  - path_points : List<Vector3>
  + setPath(List<Vector3Int>)
  + IsMoving() : bool
  + stop()
  + start()
  + setLookAt(Vector3)
  + update() : IEnumerator
}

class ImageToGrid {
  - img : Texture2D
  - grid : int[,]
}

class InputCompat <<static>> {
    + leftClickDown() : bool
    + MousePositionScreen() : Vector3
}

abstract class GridInterface {
  + MoveCreature(GameObject) : IEnumerator
  + targetSelect(int, CoroutineResult<GameObject>) : IEnumerator
}

interface ITokenMovement {
  + setPath(List<Vector3Int>)
  + IsMoving() : bool
  + stop()
  + start()
  + setLookAt(Vector3)
  + update() : IEnumerator
}

enum CameraType {
    Movement
  Focus
  Pick
  Target
  Orbit
}


CameraManager --> CameraType
GridRenderer3D --> ImageToGrid
GridCharacterController3D --> GridRenderer3D
GridCharacterController3D --> CameraManager
GridCharacterController3D --> TokenMovement
GridCharacterController3D --> InputCompat
' GridCharacterController3D --> ITokenMovement
GridInterface <|-- GridRenderer3D
SingletonMonoBehaviour "<T=CameraManager>" <|-- CameraManager
SingletonMonoBehaviour "<T=GridInterface>" <|-- GridInterface
ITokenMovement <|.. TokenMovement
@enduml


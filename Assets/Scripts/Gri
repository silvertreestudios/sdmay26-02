d\GameSetup.cs
using UnityEngine;

public class GameSetup : MonoBehaviour 
{
    [SerializeField] private GameObject playerPrefab;
    [SerializeField] private GridRenderer3D grid;

    void Start()
    {
        // First player
        var player1GameObject = new GameObject("Player1");
        var player1Controller = player1GameObject.AddComponent<GridCharacterController3D>();
        player1Controller.playerId = 0;
        player1Controller.prefab = playerPrefab;
        player1Controller.grid = grid;

        // Second player 
        var player2GameObject = new GameObject("Player2");
        var player2Controller = player2GameObject.AddComponent<GridCharacterController3D>();
        player2Controller.playerId = 1;
        player2Controller.prefab = playerPrefab;
        player2Controller.grid = grid;
    }
}
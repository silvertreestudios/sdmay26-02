<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <ui:Style src="project://database/Assets/UIStuff/MainMenu/MainMenu.uss?fileID=7433441132597879392&amp;guid=8e82ad040e85c5744b146f41098b4652&amp;type=3#MainMenu" />
    <ui:VisualElement name="Panel" class="menu-root" style="background-image: url(&quot;project://database/Assets/UIStuff/MainMenu/FlameBackground.jpg?fileID=2800000&amp;guid=af8dc1d3d3311dc4db5cc4c580b7ef05&amp;type=3#FlameBackground&quot;);">
        <ui:VisualElement class="title-stack">
            <ui:Label text="Paths Unbound" name="GameTitle" class="game-title" />
            <ui:Label text="Undying Wrath" name="GameSubtitle" class="game-subtitle" />
        </ui:VisualElement>
        <ui:GroupBox name="BoxForButtons" class="menu-card">
            <ui:Label text="PROCEDURAL DUNGEON" class="menu-heading" />
            <ui:TextField label="Optional seed" name="SeedField" max-length="20" class="seed-field" tooltip="Enter a signed 64-bit whole number, or leave blank for a random seed." />
            <ui:Label text="Leave blank to generate a new seed." class="seed-hint" />
            <ui:Button text="New Run" name="NewRunButton" class="menu-primary" />
            <ui:Button text="Continue" name="ContinueButton" class="menu-secondary" />
            <ui:Label text="" name="MenuStatusLabel" class="menu-status" />
            <ui:VisualElement class="menu-divider" />
            <ui:Button text="Settings" name="OptionsButton" />
            <ui:Button text="Exit" name="ExitButton" />
        </ui:GroupBox>
        <ui:VisualElement name="OverwriteConfirmationOverlay" class="modal-overlay">
            <ui:VisualElement class="modal-dialog">
                <ui:Label text="Replace saved run?" class="modal-title" />
                <ui:Label text="Starting a new dungeon run permanently replaces the current autosave." class="modal-message" />
                <ui:VisualElement class="modal-buttons">
                    <ui:Button text="Replace &amp; Start" name="ConfirmOverwriteButton" class="modal-confirm" />
                    <ui:Button text="Cancel" name="CancelOverwriteButton" class="modal-cancel" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

.bubble-root {
    position: absolute;
    flex-direction: column;
    align-items: center;
    display: none;
}

.bubble-box {
    background-color: rgba(20, 15, 10, 0.88);
    border-color: rgb(160, 120, 60);
    border-width: 2px;
    border-radius: 10px;
    padding: 12px 16px;
    max-width: 300px;
}

.bubble-text {
    color: rgb(240, 220, 170);
    font-size: 14px;
    white-space: normal;
    -unity-text-align: upper-left;
}

.bubble-arrow {
    width: 0;
    height: 0;
    border-left-width: 10px;
    border-right-width: 10px;
    border-top-width: 10px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgb(160, 120, 60);
}

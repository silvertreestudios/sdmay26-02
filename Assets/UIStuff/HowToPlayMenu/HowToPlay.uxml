<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UIStuff/HowToPlayMenu/HowToPlay.uss?fileID=7433441132597879392&amp;guid=1d22ed483aaed492888920569a0a0702&amp;type=3#HowToPlay" />
    <ui:VisualElement name="Overlay" style="flex-grow: 1; width: 100%; height: 100%; align-items: center; justify-content: center; flex-direction: column; background-color: rgba(0, 0, 0, 0.6);">
        <ui:VisualElement name="Panel" style="align-items: flex-start; justify-content: flex-start; flex-direction: column; background-color: rgb(86, 92, 68); padding-top: 40px; padding-bottom: 40px; padding-left: 60px; padding-right: 60px; border-top-left-radius: 20px; border-top-right-radius: 20px; border-bottom-right-radius: 20px; border-bottom-left-radius: 20px; width: 75%; height: 75%;">
            <ui:Label text="How to Play" name="HowToPlayTitle" style="-unity-font-definition: resource(&apos;Metamorphous-Regular SDF&apos;); font-size: 80px; color: rgb(236, 200, 144); background-color: rgb(62, 18, 15); border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; margin-bottom: 15px; padding-left: 30px; padding-right: 30px; padding-top: 10px; padding-bottom: 10px;" />
            <ui:VisualElement name="HowToPlayContent" style="flex-grow: 1; width: 100%; background-color: rgb(66, 72, 50); border-top-left-radius: 8px; border-top-right-radius: 8px; border-bottom-right-radius: 8px; border-bottom-left-radius: 8px; padding-top: 8px; padding-bottom: 8px; padding-left: 8px; padding-right: 8px;">
                <ui:Label text="Stride:&#10;- Left-click on a highlighted cell to preview the movement path.&#10;- Double-click to move along the path.&#10;- Right-click or press Cancel to cancel the action.&#10;&#10;Unarmed Strike / &lt;Weapon&gt;:&#10;- Left-click on a highlighted cell containing an enemy to attack.&#10;- Right-click or press Cancel to cancel the action.&#10;&#10;End Turn:&#10;- Ends the current creature&apos;s turn.&#10;&#10;Cancel:&#10;- Cancels the current action in progress.&#10;&#10;Auto Camera (C):&#10;- When enabled, the camera automatically follows the active character each turn.&#10;- Press C to toggle auto camera on or off.&#10;- Moving the camera manually will automatically disable auto camera." name="HowToPlayText" style="color: rgb(236, 200, 144); font-size: 20px; white-space: pre-wrap; flex-wrap: wrap; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
            </ui:VisualElement>
            <ui:VisualElement name="BackButtonContainer" style="width: 100%; align-items: flex-end;">
                <ui:Button text="Back" name="BackButton" style="width: 200px;" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>

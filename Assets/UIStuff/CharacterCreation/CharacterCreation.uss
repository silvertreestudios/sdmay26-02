:root {
}

.panel {
    background-color: rgba(152, 251, 152, 0);
    flex-direction: row;
    align-items: flex-start;
    justify-content: space-between;
    align-content: flex-start;
}

.unity-tab__header {
    background-color: rgb(68, 24, 13);
    color: rgb(233, 196, 140);
    -unity-font-style: bold;
    font-size: 20px;
    -unity-font-definition: resource("TitilliumWeb-Regular SDF");
}

.unity-tab__header:checked {
    background-color: rgb(122, 62, 46);
}

.tab-content {
    background-color: rgb(216, 195, 134);
    color: rgb(1, 43, 13);
    font-size: 20px;
    -unity-font-style: bold;
    -unity-font-definition: resource("TitilliumWeb-Regular SDF");
    /* align-self: flex-end; */
}

.unity-tab__header-underline {
    opacity: 0;
}

.unity-text-field__input {
    background-color: rgb(216, 195, 134); /*box color*/
    color: rgb(1, 43, 13); /*text color*/

    /*keeps the text field from slightly stretching upon populating*/
    padding-top: 0;
    padding-bottom: 0;
}

.unity-integer-field__input {
    background-color: rgb(216, 195, 134); /*box color*/
    color: rgb(1, 43, 13); /*text color*/

    /*keeps the text field from slightly stretching upon populating*/
    padding-top: 0;
    padding-bottom: 0;
}

.unity-text-field {
    background-color: rgb(1, 43, 13);
    color: rgb(216, 195, 134);
    font-size: 20px;
    -unity-font-definition: resource("TitilliumWeb-Regular SDF");
}

.unity-integer-field {
    background-color: rgb(1, 43, 13);
    color: rgb(216, 195, 134);
    font-size: 20px;
    -unity-font-definition: resource("TitilliumWeb-Regular SDF");
}

.unity-foldout {
    font-size: 20px;
    -unity-font-definition: resource("TitilliumWeb-Regular SDF");
}

/*SET WIDTH BUT FEEL FREE TO ADJUST AS NEEDED*/
#ChoiceTabs {
    width: 530px;
}

.unity-radio-button-group {
    font-size: 20px;
    -unity-font-definition: resource("TitilliumWeb-Regular SDF");
}

/*horizontal radio buttons rather than vertical */
.unity-radio-button-group__container{
    flex-direction: row; /* or row-reverse*/
    flex-wrap: wrap;
    width: 100%;
}

.unity-radio-button__input {
    flex-direction: column;
    align-items: center; /* Centers both the icon and text */
}

.unity-radio-button__label {
    margin-top: 4px; /* Space between icon and text */
    -unity-text-align: middle-center;

    align-self: center;
}

.unity-radio-button {
    font-size: 20px;
    -unity-font-definition: resource("TitilliumWeb-Regular SDF");
    flex-direction: column-reverse; 

    width: 25%; 
}

.unity-radio-button__checkmark-background {
    -unity-background-scale-mode: scale-to-fit;

    width: 50px;
    height: 50px;
}

#Elf .unity-radio-button__checkmark-background {
    background-image: resource("Icons/elf");
}

#Gnome .unity-radio-button__checkmark-background {
    background-image: resource("Icons/gnome");
}

#Goblin .unity-radio-button__checkmark-background {
    background-image: resource("Icons/goblin");
}

#Leshy .unity-radio-button__checkmark-background {
    background-image: resource("Icons/leshy");
}

#Dwarf .unity-radio-button__checkmark-background {
    background-image: resource("Icons/dwarf");
}

#Halfling .unity-radio-button__checkmark-background {
    background-image: resource("Icons/halfling");
}

#AcolyteRadioButton .unity-radio-button__checkmark-background {
    background-image: resource("Icons/acolyte");
}

#BanditRadioButton .unity-radio-button__checkmark-background {
    background-image: resource("Icons/bandit");
}

#CookRadioButton .unity-radio-button__checkmark-background {
    background-image: resource("Icons/cook");
}

.my-label {
    font-size: 18px;
    color: rgb(218, 165, 32);
    -unity-font-definition: resource("TitilliumWeb-Regular SDF");
}

.unity-button {
    font-size: 16px;
    background-color: rgb(68, 24, 13);
    color: rgb(233, 196, 140);
    -unity-text-outline-color: rgb(57, 16, 19);
    -unity-text-outline-width: 0;
    -unity-font-definition: resource("TitilliumWeb-Regular SDF");
}

.unity-button:hover {
    background-color: rgb(122, 62, 46);
    transition-duration: 0.5s;
}
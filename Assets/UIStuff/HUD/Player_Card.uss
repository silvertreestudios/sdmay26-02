:root {
}

#Card.card-inactive {
    translate: 0px 110px;
    transition-property: translate;
    transition-duration: 0.3s;
}

#Card.card-inactive:hover {
    translate: 0px 0px;
}

.health-bar-container {
    width: 100%;
    height: 29px;
    background-color: rgb(68, 24, 13);
    flex-direction: row;
    position: relative;
    border-radius: 3px;
    overflow: hidden;
    align-self: stretch;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
}

.health-bar-fill {
    flex-shrink: 0;
    height: 100%;
}

.health-bar-green {
    background-color: rgba(5, 158, 5, 1);
}

.health-bar-blue {
    background-color: rgba(60, 130, 230, 1);
}

.health-bar-empty {
    background-color: rgba(0, 0, 0, 0);
}

.health-bar-label {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    -unity-text-align: middle-center;
    color: rgb(255, 255, 255);
    font-size: 14px;
    -unity-font-definition: resource('TitilliumWeb-Regular SDF');
}

.action-point-container {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-wrap: nowrap;
    flex-grow: 0;
    flex-shrink: 0;
    width: 192px;
    height: 96px;
    min-width: 192px;
    max-width: 192px;
    min-height: 96px;
    max-height: 96px;
}

.action-medallion {
    position: relative;
    width: 31px;
    height: 31px;
    min-width: 31px;
    max-width: 31px;
    min-height: 31px;
    max-height: 31px;
    flex-grow: 0;
    flex-shrink: 0;
    margin-left: 12px;
    margin-right: 12px;
    border-top-left-radius: 5px;
    border-top-right-radius: 5px;
    border-bottom-left-radius: 5px;
    border-bottom-right-radius: 5px;
    border-width: 2px;
    align-items: center;
    justify-content: center;
    rotate: 45deg;
}

.action-medallion-core {
    width: 11px;
    height: 11px;
    min-width: 11px;
    max-width: 11px;
    min-height: 11px;
    max-height: 11px;
    flex-grow: 0;
    flex-shrink: 0;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-left-radius: 2px;
    border-bottom-right-radius: 2px;
    border-width: 2px;
}

.action-medallion--filled {
    background-color: rgb(209, 153, 50);
    border-color: rgb(255, 232, 149);
}

.action-medallion--filled > .action-medallion-core {
    background-color: rgb(255, 238, 178);
    border-color: rgb(97, 52, 18);
}

.action-medallion--empty {
    background-color: rgba(28, 23, 21, 0.82);
    border-color: rgb(127, 91, 53);
}

.action-medallion--empty > .action-medallion-core {
    background-color: rgba(18, 16, 15, 0.72);
    border-color: rgb(83, 60, 42);
}

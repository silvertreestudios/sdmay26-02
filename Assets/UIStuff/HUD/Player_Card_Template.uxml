    <ui:VisualElement name="Card" style="flex-grow: 1; justify-content: space-evenly; opacity: 1; background-color: rgba(166, 49, 49, 0.65); width: 175px; height: 245px; background-image: url(&quot;project://database/Assets/UIStuff/PNG/CardBase.png?fileID=2800000&amp;guid=a572d33b6852d4099ac060af9fbdd2c3&amp;type=3#CardBase&quot;); align-items: flex-start; align-content: auto; align-self: center; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; flex-direction: column;">

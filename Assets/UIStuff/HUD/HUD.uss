:root {
    --combat-log-border-color: rgb(233, 196, 140);
    --combat-log-border-width: 2px;
    --combat-log-toggle-border-color: rgb(233, 196, 140);
    --combat-log-toggle-border-width: 2px;
    --combat-log-toggle-offset: 20px;
}

.unity-button {
    -unity-font-definition: resource('TitilliumWeb-Regular SDF');
    font-size: 36px;
    color: rgb(233, 196, 140);
    background-color: rgb(68, 24, 13);
    border-color: rgb(233, 196, 140);
    border-width: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    margin: 0;
    padding: 0;
    min-width: 0;
    overflow: hidden;
}

.unity-button:hover {
    background-color: rgb(122, 62, 46);
    transition-duration: 0.5s;
}

/* 2-column button grid */
.btn-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

/* Reduced font size for long button labels (> 10 characters) */
.btn-small-text {
    font-size: 24px;
}

/* Action buttons - burnt orange */
.btn-action {
    background-color: rgb(180, 80, 20);
    width: 50%;
    flex-grow: 0;
    flex-shrink: 0;
}
.btn-action:hover {
    background-color: rgb(210, 110, 40);
    transition-duration: 0.5s;
}

/* Movement buttons - navy blue */
.btn-movement {
    background-color: rgb(30, 60, 140);
    width: 50%;
    flex-grow: 0;
    flex-shrink: 0;
}
.btn-movement:hover {
    background-color: rgb(50, 90, 180);
    transition-duration: 0.5s;
}

/* General HUD buttons - green */
.btn-general {
    background-color: rgb(40, 110, 50);
    width: 50%;
    flex-grow: 0;
    flex-shrink: 0;
}
.btn-general:hover {
    background-color: rgb(60, 150, 70);
    transition-duration: 0.5s;
}


.btn-cancel {
    background-color: rgb(140, 25, 15);
    width: 50%;
    flex-grow: 0;
    flex-shrink: 0;
}
.btn-cancel:hover {
    background-color: rgb(180, 40, 25);
    transition-duration: 0.5s;
}

.btn-hud-disabled {
    color: rgb(145, 145, 145);
    background-color: rgb(55, 55, 55);
    border-color: rgb(105, 105, 105);
    opacity: 0.65;
}

.btn-hud-disabled:hover {
    background-color: rgb(55, 55, 55);
}

.combat_log_background {
    padding-bottom: 15px;
    background-color: rgba(86, 92, 68, 0.35);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-width: var(--combat-log-border-width);
    border-color: var(--combat-log-border-color);
}

#LogToggleButton {
    width: 28px;
    height: 60px;
    font-size: 16px;
    padding: 0;
    background-color: rgb(62, 18, 15);
    border-top-left-radius: 8px;
    border-bottom-left-radius: 8px;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-top-width: var(--combat-log-toggle-border-width);
    border-bottom-width: var(--combat-log-toggle-border-width);
    border-left-width: var(--combat-log-toggle-border-width);
    border-right-width: 0;
    border-color: var(--combat-log-toggle-border-color);
    margin-top: var(--combat-log-toggle-offset);
}

.combat_log_background:hover {
    background-color: rgba(86, 92, 68, 0.35);
}

.combat_log_text {
    transition-duration: 0.5s;
}

.combat_log_text:hover {
    text-color: rgb(233, 196, 140);
    transition-duration: 0.5s;
}

#UpperArea {
    overflow: visible;
}

#CombatLogWrapper {
    overflow: visible;
}

#ResizeHandle {
    position: absolute;
    bottom: 0;
    z-index: 100;
    left: 50%;
    width: 120px;
    margin-left: -60px;
    height: 30px;
    translate: 0 50%;
    background-color: rgb(62, 18, 15);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    align-items: center;
    justify-content: center;
}


#ResizeHandle > .unity-label {
    color: rgb(180, 120, 80);
    font-size: 30px;
    -unity-text-align: middle-center;
}

.speed_bar_background {
    background-color: rgb(86, 92, 68);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-width: 2px;
    border-color: rgb(233, 196, 140);
}

.btn-speed-toggle {
    width: 60px;
    height: 22px;
    font-size: 14px;
    background-color: rgb(62, 18, 15);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    border-top-width: 0;
    border-left-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-color: rgb(233, 196, 140);
    margin: 0;
    padding: 0;
}

.btn-speed--pause {
    -unity-font-style: bold;
}

.btn-speed {
    width: 70px;
    height: 50px;
    font-size: 20px;
    background-color: rgb(68, 24, 13);
    margin-left: 4px;
    margin-right: 4px;
}

.btn-tactics-mode {
    width: 220px;
    font-size: 18px;
}

.btn-speed--active {
    background-color: rgb(180, 80, 20);
    border-color: rgb(255, 220, 100);
}

.dungeon-run-status {
    min-width: 300px;
    height: 34px;
    margin-bottom: 5px;
    padding-left: 14px;
    padding-right: 14px;
    -unity-text-align: middle-center;
    -unity-font-definition: resource("TitilliumWeb-Regular SDF");
    font-size: 19px;
    color: rgb(255, 230, 185);
    background-color: rgba(42, 31, 27, 0.94);
    border-color: rgb(233, 196, 140);
    border-width: 2px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

.dungeon-run-status--error {
    color: rgb(255, 171, 148);
    border-color: rgb(210, 70, 45);
    white-space: normal;
    height: 56px;
}

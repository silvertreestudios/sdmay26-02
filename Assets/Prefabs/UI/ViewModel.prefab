  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Game.Creature.CreatureComponent
  _name: Goblin Warrior
  _level: -1
  _initiative: 2
  _speed: 25
  _hp: 6
  _maxHp: 6
  _tempHp: 0
  _ac: 16
  _attackBonus: 7
  _damageBonus: 0
  _weaponBonuses: []
  _armorBonuses: []
  _strMod: 0
  _dexMod: 3
  _conMod: 1
  _intMod: 0
  _wisMod: -1
  _chaMod: 1

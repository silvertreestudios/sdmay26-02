  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Game.Creature.CreatureComponent
  _name: Goblin Warrior
  _level: -1
  _initiative: 2
  _speed: 25
  _hp: 6
  _maxHp: 6
  _tempHp: 0
  _ac: 16
  _attackBonus: 7
  _damageBonus: 0

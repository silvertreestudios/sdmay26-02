  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Game.Creature.CreatureComponent
  _name: Kobold Warrior
  _level: -1
  _initiative: 3
  _speed: 25
  _hp: 7
  _maxHp: 7
  _tempHp: 0
  _ac: 16
  _attackBonus: 3
  _damageBonus: 1
  _weaponBonuses:
  - category: unarmed
